[Unit]
Description=Watch for new Quartermaster logs
Wants=quartermaster-logs.service

[Path]
PathChanged=/var/lib/quartermaster/quartermaster/logs
PathChanged=/var/lib/quartermaster/quartermaster/recon
PathChanged=/var/lib/quartermaster/quartermaster/aircraft
Unit=quartermaster-logs-changed.service

[Install]
WantedBy=multi-user.target
