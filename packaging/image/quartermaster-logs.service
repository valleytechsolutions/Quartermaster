[Unit]
Description=Let the _quartermaster group read the Quartermaster logs
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=_quartermaster
LogLevelMax=notice
SuccessExitStatus=SIGTERM
ExecStart=-/usr/bin/find /var/lib/quartermaster/quartermaster/logs /var/lib/quartermaster/quartermaster/recon /var/lib/quartermaster/quartermaster/aircraft -ignore_readdir_race ( -type d ! -perm -050 -o -type f ! -perm -040 ) -exec chmod -f g+rX {} +
ExecStart=/usr/bin/sleep 2
ExecStart=-/usr/bin/find /var/lib/quartermaster/quartermaster/logs /var/lib/quartermaster/quartermaster/recon /var/lib/quartermaster/quartermaster/aircraft -ignore_readdir_race ( -type d ! -perm -050 -o -type f ! -perm -040 ) -exec chmod -f g+rX {} +
