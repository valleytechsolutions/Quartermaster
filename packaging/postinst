#!/bin/sh
# Regular login users get the screen (video), keyboard (input), GPS serial ports (dialout),
# cap and Grove power and the LoRa radio's lines (gpio), the LoRa radio (spi) and its antenna
# switch (i2c), Bluetooth scanning (bluetooth) and Wi-Fi scan requests through
# NetworkManager (netdev), the RTL-SDR stick (plugdev), the speaker for alert tones (audio)
# and the radio helper for Deep scan, direct scans and radio tuning (quartermaster-radio).
# The helper's socket waits for the first connection; nothing listens in monitor mode until
# Deep scan is turned on in Settings and a wardrive or Recon starts.
set -e
if ! getent group quartermaster-radio >/dev/null; then
    addgroup --system quartermaster-radio
fi
for user in $(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 {print $1}'); do
    for grp in video input dialout gpio spi i2c bluetooth netdev plugdev audio quartermaster-radio; do
        if getent group "$grp" >/dev/null; then
            usermod -aG "$grp" "$user" || true
        fi
    done
done
if [ -f /usr/lib/tmpfiles.d/quartermaster.conf ] && command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/quartermaster.conf || true
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl enable --now quartermaster-radio.socket || true
fi
if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
fi
exit 0
