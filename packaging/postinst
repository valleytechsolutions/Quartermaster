#!/bin/sh
# Screen (video), keyboard (input), GPS serial ports (dialout), Grove port power (gpio),
# Bluetooth scanning (bluetooth) and Wi-Fi scan requests through NetworkManager (netdev)
# for regular login users.
set -e
for user in $(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 {print $1}'); do
    for grp in video input dialout gpio bluetooth netdev; do
        if getent group "$grp" >/dev/null; then
            usermod -aG "$grp" "$user" || true
        fi
    done
done
if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/quartermaster.conf || true
fi
exit 0
